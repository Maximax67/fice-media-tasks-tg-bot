{
  "name": "tg-task-bot",
  "version": "1.0.0",
  "description": "Telegram Task Bot",
  "main": "src/index.ts",
  "author": "Maxim Belikov",
  "scripts": {
    "dev": "DEBUG=bot* dotenv -- nodemon -e ts -x ts-node src/index.ts",
    "devWindows": "@powershell -Command $env:DEBUG='bot*';dotenv -- -- nodemon -e ts -x ts-node src/index.ts",
    "build": "ncc build src/index.ts -o build -m",
    "prettier": "prettier --write src/**/*.ts",
    "lint": "tsc --noemit"
  },
  "dependencies": {
    "@vercel/node": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "nekosia.js": "^0.2.10",
    "pg": "^8.23.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.23.1",
    "@vercel/ncc": "^0.45.0",
    "debug": "^4.4.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
